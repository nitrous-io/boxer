#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
shopt -s nullglob

ip=${1}
port=${2}

(
  flock -x 200
  iptables -t nat -C PREROUTING ! -s 192.168.1.0/16 -p tcp --dport ${port} -j DNAT --to ${ip}:22
  if [ $? -ne 0]; then
    iptables -t nat -D PREROUTING ! -s 192.168.1.0/16 -p tcp --dport ${port} -j DNAT --to ${ip}:22
  fi
) 200>/var/lock/boxer.release_portforwarding
