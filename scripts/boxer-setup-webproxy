#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

name=${1}
name_underscored=${2}
ip=${3}

read -d '' acl <<"EOF"

    acl is_${name_underscored} hdr_beg(Host) -i ${name}.
    use_backend ${name} if is_${name_underscored}
EOF

read -d '' backend_def <<"EOF"

backend ${name}
    server box-server 192.168.254.${ip} weight 1 maxconn 1024
EOF

sed -i /#pragma mark ACTION_ACL_MARKER/ a\${acl}/ /etc/haproxy/haproxy.cfg
sed -i /#pragma mark ACTION_BACKEND_MARKER/ a\${backend_def}/ /etc/haproxy/haproxy.cfg
