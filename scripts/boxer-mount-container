#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

box_id=${1}
lxc_root=${2}
box_name=${3}
container_template=${4}
disk_limit=${5}

box_path=${lxc_root}/${box_name}
box_delta_path=${box_path}_delta
container_path=${lxc_root}/${container_template}
mount_options=rw,upperdir=${box_delta_path},lowerdir=${container_path}
fstab_config=$(cat <<EOF
none ${box_path} overlayfs ${mount_options} 0 0
EOF
)

mkdir -p ${box_path}

if [[ ! `cat /proc/mounts | grep "${box_name}"` ]]; then
  mount -n -t overlayfs -o ${mount_options} none ${box_path}
  echo "${fstab_config}" >> /etc/fstab
fi

if [[ `df -T | grep "xfs.*${lxc_root}$"` ]]; then
  echo "${box_id}:${box_delta_path}/rootfs/home/action" >> /etc/projects
  echo "${box_name}:${box_id}" >> /etc/projid

  xfs_quota -x -c "project -s ${box_name}" ${lxc_root}
  xfs_quota -x -c "limit -p bhard=${disk_limit} ${box_name}" ${lxc_root}
fi
