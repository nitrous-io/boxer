#!/bin/bash
# This now uses `sparse` mount method which expect a disk at /lxc/disk1

set -o errexit
set -o xtrace
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_id=${1}
box_name=${2}
ip=${3}
port=${4}
if [ $# -eq 5 ]; then
  dont_start="false"
else
  dont_start=$5
fi
disk=/lxc/disk1

disk_limit="2G"

container_name=${box_name}-${box_id}
file=$disk/$container_name.img
container_template='base_container_template'
box_path=${lxc_root}/${container_name}
box_delta_path=${box_path}_delta
container_path=${lxc_root}/${container_template}
network_config=$(cat <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address ${ip}
    netmask 255.255.255.0
    gateway 192.168.254.1
EOF
)

# create a logical volume with size=disk_limit
dd if=/dev/zero of=$file bs=1 count=0 seek=$disk_limit
mkfs.ext4 -F -i 8192 $file

# mount the volume in disk
mkdir -p $box_delta_path
mount -t ext4 $file $box_delta_path

# overlay box and the base container template
mkdir -p $box_path
mount -n -t aufs -o br=$box_delta_path:$container_path none $box_path

# set uid of home folder
action_uid=`chroot ${container_path}/rootfs /usr/bin/id -u action`
action_gid=`chroot ${container_path}/rootfs /usr/bin/id -g action`
chown -R ${action_uid}:${action_gid} $box_path/rootfs/home/action

# Set Memory and Swap
sed -i "/lxc.cgroup.memory.limit_in_bytes/d" ${box_path}/config
sed -i "/lxc.cgroup.memory.memsw.limit_in_bytes/d" ${box_path}/config

echo "lxc.cgroup.memory.limit_in_bytes = 256M" >> ${box_path}/config
echo "lxc.cgroup.memory.memsw.limit_in_bytes = 512M" >> ${box_path}/config

sed -i "s/${container_template}/${container_name}/g" ${box_path}/config
sed -i "s/${container_template}/${container_name}/g" ${box_path}/rootfs/etc/hosts

echo "${container_name}" > ${box_path}/rootfs/etc/hostname
echo "${network_config}" > ${box_path}/rootfs/etc/network/interfaces

iptables -t nat -A PREROUTING ! -s 192.168.1.0/16 -p tcp --dport ${port} -j DNAT --to ${ip}:22

if [[ $dont_start != 'dont-start' ]]; then
  lxc-start -n ${container_name} -d
  lxc-wait -n ${container_name} -s RUNNING
  echo "STARTING"
fi
