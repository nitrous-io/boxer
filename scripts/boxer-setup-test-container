#!/bin/bash

set -o errexit
set -o xtrace
shopt -s nullglob

disk='/lxc/disk1'
lxc_root='/var/lib/lxc'
box_id=${1}
box_name=${2}
ip=${3}
port=${4}

container_name=${box_name}-${box_id}
container_template='base_container_template'
box_path=${disk}/${container_name}
box_delta_path=${box_path}_delta
container_path=${disk}/${container_template}
network_config=$(cat <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address ${ip}
    netmask 255.255.255.0
    gateway 192.168.254.1
EOF
)

mount_options=rw,upperdir=${box_delta_path},lowerdir=${container_path}

mkdir -p ${box_path}
mkdir -p ${box_delta_path}
mkdir -p ${lxc_root}/${container_name}

action_uid=`chroot ${container_path}/rootfs /usr/bin/id -u action`
action_gid=`chroot ${container_path}/rootfs /usr/bin/id -g action`

mkdir -p ${box_delta_path}/rootfs/home/action
chown -R ${action_uid}:${action_gid} ${box_delta_path}/rootfs/home/action

# overlay in disk
mount -n -t overlayfs -o ${mount_options} none ${box_path}
# bind to lxc location so we can have lxc goodies
mount --bind ${box_path} ${lxc_root}/${container_name}

echo "${box_id}:${box_delta_path}/rootfs/home/action" >> /etc/projects
echo "${container_name}:${box_id}" >> /etc/projid

xfs_quota -x -c "project -s ${container_name}" ${disk}
xfs_quota -x -c "limit -p bhard=${disk_limit} ${container_name}" ${disk}

sed -i "s/${container_template}/${container_name}/g" ${box_path}/config
echo "${container_name}" > ${box_path}/rootfs/etc/hostname
echo "${network_config}" > ${box_path}/rootfs/etc/network/interfaces

iptables -t nat -A PREROUTING -p tcp --dport ${port} -j DNAT --to ${ip}:22

if [[ $5 != 'dont-start' ]]; then
  lxc-start -n ${container_name} -d
  while ! nc -z ${ip} 22 ; do sleep 0.5; done

  echo "STARTING"
fi
