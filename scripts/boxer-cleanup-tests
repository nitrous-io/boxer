#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

name='mclovins-container'
lxc_root='/var/lib/lxc'
box_path=${lxc_root}/${name}

if [ -d ${box_path} ]; then
  echo 'Stopping the container'
  lxc-stop -n ${name}
  lxc-wait -n ${name} -s STOPPED

  if [[ `cat /proc/mounts | grep "${name}"` ]]; then
    echo 'Unmounting the container'
    umount ${box_path}
    echo 'Removing line from /etc/fstab'
    sed -i "/${name}/d" /etc/fstab
  fi

  if [ -f /etc/projects ]; then
    echo 'Removing line from /etc/projects'
    sed -i "/${name}/d" /etc/projects
  fi

  if [ -f /etc/projid ]; then
    echo 'Removing line from /etc/projid'
    sed -i "/${name}/d" /etc/projid
  fi

  echo 'Deleting all remnants of the container'
  rm -rf ${box_path}*

  echo 'Flushing IPTables'
  iptables -t nat -F

  echo "Deleting /etc/lxc/auto/${name}.conf"
  if [ -h /etc/lxc/auto/${name}.conf ]; then
    rm -f /etc/lxc/auto/${name}.conf
  fi
fi
