#!/bin/bash -x

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root=${1}
box_name=${2}
username='action'

box_path=${1}/${2}/rootfs
profile_path=${box_path}/etc/profile

if [ -f ${profile_path} ]; then
  for key in "${@:3}"; do
    # remove existing key
    sed -i "/export ${key}=/d" ${profile_path}
  done
fi
