#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

container_name=$1
disk_limit=$2
disk=$3
file=$disk/$container_name.img

(
  flock -x 200

  # create the volume
  dd if=/dev/zero of=$file bs=1 count=0 seek=$disk_limit
  if [[ $? != 0 ]]; then
    rm $file
    exit 1
  fi

  mkfs.ext4 -F -i 8192 $file
  if [[ $? != 0 ]]; then
    rm $file
    exit 1
  fi
) 200>/var/lock/boxer.${container_name}.create_volume
