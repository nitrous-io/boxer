#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

vg=boxhost
pool=boxes
container_name=$1
disk_limit=$2

(
  flock -x 200

  lvcreate -T $vg/$pool -V $disk_limit -n $container_name
  if [[ $? != 0 ]]; then
    lvremove -f /dev/$vg/$container_name
    exit 1
  fi

  mkfs -t ext4 /dev/$vg/$container_name
  if [[ $? != 0 ]]; then
    lvremove -f /dev/$vg/$container_name
    exit 1
  fi
) 200>/var/lock/boxer.create_volume
