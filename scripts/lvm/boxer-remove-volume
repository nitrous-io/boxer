#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

container_name=${1}
vg=$2
lv=/dev/$vg/$container_name
box_path=/var/lib/lxc/$container_name
box_delta_path=/var/lib/lxc/${container_name}_delta

# double-check that the paths are all unmounted
(
  flock -x 200
  if [[ `cat /proc/mounts | grep "${box_path}\s\+"` ]]; then
    umount $box_path
  fi
  if [[ `cat /proc/mounts | grep "${box_delta_path}\s\+"` ]]; then
    umount $box_delta_path
  fi

  # FIXME: See why sometimes this gives an error:
  # rm: cannot remove device or resource busy (even tho its not mounted)
  # or lsof +D #{path} gives nothing
  rm -rf $box_path || true
  rm -rf $box_delta_path || true

  lvchange -a n $lv
  lvremove -f $lv
) 200>/var/lock/boxer.${container_name}.remove_volume
