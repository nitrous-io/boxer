#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
id=${1}
container_name=${2}
container_template=${3}
cpu_shares=${4}
memory=${5}
total_memory=${6}
swappiness=${7}
ip=${8}
gateway=${9}
interface=${10}
uid=${11}
gid=${12}

network_config=$(cat <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address ${ip}
    netmask 255.255.255.0
    gateway ${gateway}
EOF
)
container_path=$lxc_root/$container_name

# Untar the contents of the specific container template (ruby, python, etc.) into the box itself
home_data_path=${lxc_root}/${container_template}
tar -xzSpf $home_data_path.tar.gz -C $container_path/rootfs/home/action

# http://www.funtoo.org/wiki/Linux_Containers
# http://serverfault.com/questions/40712/what-range-of-mac-addresses-can-i-safely-use-for-my-virtual-machines
mac_address=`printf "02:00:%x:%x:%x:%x" ${ip//./ }`

# Set lxc config
lxc_config_path=$container_path/config
sed -i "/lxc.network.link/d" $lxc_config_path
sed -i "/lxc.network.hwaddr/d" $lxc_config_path
sed -i "/lxc.cgroup.memory.limit_in_bytes/d" $lxc_config_path
sed -i "/lxc.cgroup.memory.memsw.limit_in_bytes/d" $lxc_config_path
sed -i "/lxc.cgroup.memory.swappiness/d" $lxc_config_path
sed -i "/lxc.cgroup.cpu.shares/d" $lxc_config_path

echo "lxc.network.link = ${interface}" >> $lxc_config_path
echo "lxc.network.hwaddr = ${mac_address}" >> $lxc_config_path
echo "lxc.cgroup.memory.limit_in_bytes = ${memory}" >> $lxc_config_path
echo "lxc.cgroup.memory.memsw.limit_in_bytes = ${total_memory}" >> $lxc_config_path
echo "lxc.cgroup.memory.swappiness = ${swappiness}" >> $lxc_config_path
echo "lxc.cgroup.cpu.shares = ${cpu_shares}" >> $lxc_config_path

sed -i "s/base_container_template/${container_name}/g" $lxc_config_path
sed -i "s/base_container_template/${container_name}/g" $container_path/rootfs/etc/hosts

echo "${container_name}" > $container_path/rootfs/etc/hostname
echo "${network_config}" > $container_path/rootfs/etc/network/interfaces

# Create the workspace directory
mkdir -p $container_path/rootfs/home/action/workspace

# Set the UID and the GID
if [[ ! `ls -la $container_path/rootfs/home/action | grep ${uid}` ]]; then
  chroot $container_path/rootfs usermod -u ${uid} action
  chroot $container_path/rootfs groupmod -g ${gid} action
  chroot $container_path/rootfs chown -R ${uid}:${gid} /home/action
fi

# Add /etc/action/box_id and box_user
etc_action=$container_path/rootfs/etc/action
mkdir -p ${etc_action}
echo "${id}" > ${etc_action}/box_id
echo "action" > ${etc_action}/box_user
