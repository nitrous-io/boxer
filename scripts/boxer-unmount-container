#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root=${1}
box_name=${2}
box_path=${lxc_root}/${box_name}
fstab_path="/etc/fstab"

if [[ `cat /proc/mounts | grep "${box_name}"` ]]; then
  if [[ `df -T | grep "xfs.*${lxc_root}$"` ]]; then
    xfs_quota -x -c "limit -p bhard=0 ${box_name}" ${lxc_root}
    sed -i "/${box_name}/d" /etc/projects
    sed -i "/${box_name}/d" /etc/projid
  fi

  umount ${box_path}
  sed -i "/${box_name}/d" /etc/fstab
fi
