#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
container_name=${1}
disk=${2}
lxc_box_path=${lxc_root}/${container_name}
box_path=${disk}/${container_name}

# use % as delimiter for sed so we dont have to escape /
# we umount twice to remove the mount in /var/lib/lxc and /etc/fstab
(
  flock -x 200

  if [[ `cat /proc/mounts | grep "${box_path}\s\+"` ]]; then
    xfs_quota -x -c "limit -p bhard=0 ${container_name}" ${disk} 2>/dev/null
    sed -i "\%:${box_path}_delta%d" /etc/projects
    sed -i "\%${container_name}:%d" /etc/projid

    umount ${lxc_root}/${container_name}
    umount ${box_path}
  fi
) 200>/var/lock/boxer.${container_name}.unmount_container
