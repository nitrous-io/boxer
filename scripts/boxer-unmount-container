#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
box_path=${lxc_root}/${box_name}
fstab_path="/etc/fstab"

(
  flock -x 200

  if [[ `cat /proc/mounts | grep "${box_path}\>"` ]]; then
    if [[ `df -T | grep "xfs.*${lxc_root}$"` ]]; then
      xfs_quota -x -c "limit -p bhard=0 ${box_name}" ${lxc_root}
      sed -i "/\b${box_name}\b/d" /etc/projects
      sed -i "/\b${box_name}\b/d" /etc/projid
    fi

    umount ${box_path}
    sed -i "/\b${box_name}\b/d" /etc/fstab
  fi
) 200>/var/lock/boxer.unmount_container
