#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
disk=${2}
box_path=${disk}/${box_name}
box_delta_path=${box_path}_delta

# FIXME: See why sometimes this gives an error:
# rm: cannot remove device or resource busy (even tho its not mounted)
# or lsof +D #{path} gives nothing
rm -rf ${lxc_root}/${box_name} || true
rm -rf ${box_path} || true
rm -rf ${box_delta_path}/* || true
rm -rf ${box_delta_path} || true
