#!/bin/bash -x

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root=${1}
box_name=${2}
public_key=${3}
private_key=${4}
username='action'

box_path=${1}/${2}/rootfs
ssh_dir='/home/action/.ssh'
public_key_path='/home/action/.ssh/id_rsa.pub'
private_key_path='/home/action/.ssh/id_rsa'

mkdir -p ${box_path}${ssh_dir}

if [ ! -f ${box_path}${public_key_path} ]; then
  touch ${box_path}${public_key_path}
  echo "${public_key}" >> ${box_path}${public_key_path}
  chroot ${box_path} chown -R ${username}:${username} ${public_key_path}
  chroot ${box_path} chmod 644 ${public_key_path}
fi

if [ ! -f ${box_path}${private_key_path} ]; then
  touch ${box_path}${private_key_path}
  echo "${private_key}" >> ${box_path}${private_key_path}
  chroot ${box_path} chown -R ${username}:${username} ${private_key_path}
  chroot ${box_path} chmod 600 ${private_key_path}
fi
