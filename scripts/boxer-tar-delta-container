#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root=${1}
box_name=${2}
snapshot_name=${3}
box_path=${lxc_root}/${box_name}
box_delta_path=${lxc_root}/${box_name}_delta

cd $lxc_root
tar -cpzf $snapshot_name -C ${box_delta_path}/rootfs/home/action .
