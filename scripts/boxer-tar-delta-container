#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
snapshot_name=${2}
box_path=${lxc_root}/${box_name}
box_delta_path=${lxc_root}/${box_name}_delta

cd $lxc_root && tar cpzf $snapshot_name ${box_delta_path}/rootfs/home/action
