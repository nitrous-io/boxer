#!/bin/bash

[ -n "$DEBUG" ] && set -o xtrace
set -o nounset
set -o errexit
shopt -s nullglob

lxc_root='/var/lib/lxc'
box_name=${1}
container_template=${2}
ip=${3}
gateway=${4}
interface=${5}
uid=${6}
gid=${7}
network_config=$(cat <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address ${ip}
    netmask 255.255.255.0
    gateway ${gateway}
EOF
)

sed -i "/lxc.network.link/d" ${lxc_root}/${box_name}/config
echo "lxc.network.link=${interface}" >> ${lxc_root}/${box_name}/config
sed -i "s/${container_template}/${box_name}/g" ${lxc_root}/${box_name}/config
echo "${box_name}" > ${lxc_root}/${box_name}/rootfs/etc/hostname
echo "${network_config}" > ${lxc_root}/${box_name}/rootfs/etc/network/interfaces

# Set the UID and the GID
chroot ${lxc_root}/${box_name}/rootfs usermod -u ${uid} action
chroot ${lxc_root}/${box_name}/rootfs groupmod -g ${gid} action
chroot ${lxc_root}/${box_name}/rootfs chown -R ${uid}:${gid} /home/action
